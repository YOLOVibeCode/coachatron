# Copy to .env for local development. Set real values in Railway for deployed environments.
RELAY_BASE_URL=
RELAY_API_KEY=
RELAY_CONNECT_PRODUCT=
RELAY_WEBHOOK_SECRET=
LITELLM_BASE=
LITELLM_API_KEY=
SESSION_SECRET=
DATABASE_URL=
APP_BASE_URL=
APP_ENV=
# Sender for sign-in codes. Empty: the relay's shared sender. Set to
# no-reply@coachatron.com once coachatron.com is authenticated in SendGrid.
COACHATRON_EMAIL_FROM=
# Inbound texts (docs/PLATFORM.md section 3). The secret comes from the relay;
# INBOUND_SMS_URL must equal the relay manifest's inbound.sms url.
RELAY_INBOUND_SECRET=
INBOUND_SMS_URL=
# The Coachatron number, shown on the landing page as "Or text it to ...".
COACHATRON_SMS_NUMBER=
PORT=3000
